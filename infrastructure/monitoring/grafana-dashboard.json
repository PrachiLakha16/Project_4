{
  "__inputs": [],
  "__requires": [],
  "id": null,
  "uid": "sre-incident-agent-overview",
  "title": "SRE Incident Agent — Overview",
  "description": "Operational dashboard for the sre-incident-agent multi-agent incident-response service: node latency, LLM token usage, approval queue health, action outcomes, triage throughput/latency, and circuit breaker state.",
  "tags": ["sre-incident-agent", "langgraph", "fastapi"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(sre_agent_webhook_requests_total, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Namespace"
      },
      {
        "name": "environment",
        "type": "custom",
        "query": "prod,staging,dev",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "label": "Environment"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Request & Triage Throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Webhook Requests by Source / Status",
      "description": "sre_agent_webhook_requests_total — inbound Alertmanager / PagerDuty webhook rate, labeled by source and status.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, status) (rate(sre_agent_webhook_requests_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{source}} / {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Incidents Triaged by Severity",
      "description": "sre_agent_incidents_triaged_total — rate of incidents completing the triage node, labeled by severity and whether they were deduplicated.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity, deduplicated) (rate(sre_agent_incidents_triaged_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{severity}} (dedup={{deduplicated}})"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Time-to-Triage p95",
      "description": "p95 of sre_agent_time_to_triage_seconds — wall-clock time from alert ingestion to triage completion.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sre_agent_time_to_triage_seconds_bucket{namespace=~\"$namespace\"}[5m])))"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Approval Queue Depth",
      "description": "sre_agent_approval_queue_depth — number of remediation actions currently pending human approval.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sre_agent_approval_queue_depth{namespace=~\"$namespace\"})"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "LangGraph Node Latency (p50 / p95 / p99)",
      "description": "sre_agent_node_latency_seconds — latency of a single LangGraph node execution, by node.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, node) (rate(sre_agent_node_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])))",
          "legendFormat": "p50 {{node}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(sre_agent_node_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])))",
          "legendFormat": "p95 {{node}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, node) (rate(sre_agent_node_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])))",
          "legendFormat": "p99 {{node}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Actions & Reliability",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Remediation Action Success / Failure Rate",
      "description": "sre_agent_action_result_total — remediation actions executed, labeled by action_type and result (success/failure).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*failure.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*success.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action_type, result) (rate(sre_agent_action_result_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{action_type}} / {{result}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Action Failure Rate (5m)",
      "description": "Ratio of failed to total remediation actions over the last 5 minutes.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sre_agent_action_result_total{namespace=~\"$namespace\", result=\"failure\"}[5m])) / clamp_min(sum(rate(sre_agent_action_result_total{namespace=~\"$namespace\"}[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Circuit Breakers Open",
      "description": "sre_agent_circuit_breaker_open — count of dependencies whose circuit breaker is currently open (1 = open).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sre_agent_circuit_breaker_open{namespace=~\"$namespace\"})"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Circuit Breaker State by Dependency",
      "description": "sre_agent_circuit_breaker_open — 1 if the circuit breaker for a dependency is open, else 0.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 15 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sre_agent_circuit_breaker_open{namespace=~\"$namespace\"}",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "LLM Usage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "LLM Token Usage by Model / Direction",
      "description": "sre_agent_llm_tokens_total — total LLM tokens consumed, labeled by model and direction (prompt/completion).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, direction) (rate(sre_agent_llm_tokens_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{model}} / {{direction}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Token Budget Burn (1h, tokens)",
      "description": "Total tokens consumed across all models in the last hour — sanity-check against INCIDENT_TOKEN_BUDGET (per-incident, not per-hour, but useful as a coarse cost signal).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(sre_agent_llm_tokens_total{namespace=~\"$namespace\"}[1h]))"
        }
      ]
    }
  ]
}
