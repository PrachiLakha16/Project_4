# --- LLM provider routing ---
# Provider-agnostic client: "anthropic" or "openai". Anthropic is the default.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME
# Cheap/fast model used for triage, dedup, summarization, comms drafting.
LLM_MODEL_FAST=claude-haiku-4-5
# Stronger model used for RCA reasoning over correlated telemetry + RAG context.
LLM_MODEL_STRONG=claude-sonnet-5
# Hard per-incident token budget across the whole graph run.
INCIDENT_TOKEN_BUDGET=120000

# --- Postgres: LangGraph checkpointer + pgvector RAG store ---
POSTGRES_DSN=postgresql://sre_agent:changeme@localhost:5432/sre_incident_agent
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=sre-incident-agent
PROMETHEUS_METRICS_PORT=9464
LOG_LEVEL=INFO

# --- External systems (mock clients used when *_BASE_URL unset in dev/test) ---
PROMETHEUS_BASE_URL=http://prometheus.monitoring.svc.cluster.local:9090
LOKI_BASE_URL=http://loki.monitoring.svc.cluster.local:3100
KUBE_CONFIG_PATH=
KUBE_CONTEXT=
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/TOKEN
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
PAGERDUTY_API_TOKEN=REPLACE_ME
PAGERDUTY_ROUTING_KEY=REPLACE_ME

# --- Secrets management ---
# In AWS deployments, secrets above are resolved from Secrets Manager at
# infrastructure/terraform/modules/secrets and injected via IRSA + External
# Secrets Operator / the AWS Secrets Manager CSI driver, never hardcoded.
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_PREFIX=sre-incident-agent/prod

# --- API auth / RBAC ---
# HS256 shared secret for local dev only; prod uses an OIDC-issued JWT verified
# against AWS IAM/SSO group claims (see SECURITY.md).
API_JWT_SECRET=dev-only-change-me
API_JWT_AUDIENCE=sre-incident-agent

# --- Guardrails ---
APPROVAL_QUEUE_STALE_MINUTES=15
ALLOWLIST_CONFIG_PATH=src/sre_agent/guardrails/allowlist.yaml
